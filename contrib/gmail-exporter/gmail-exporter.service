[Unit]
Description=Export Gmail filter counts for razerdash (Prometheus textfile)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/gmail_count.py run
# `run` prints only on failure; without this its reason is logged at info,
# below systemd's own "Failed to start" lines.
SyslogLevel=err
